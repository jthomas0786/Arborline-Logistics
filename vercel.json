{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "batch/**": false,
      "release/**": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/connect-workers",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/connect-outreach",
      "schedule": "10 14 * * *"
    },
    {
      "path": "/api/cron/connect-outreach",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/cron/connect-outreach",
      "schedule": "10 18 * * *"
    },
    {
      "path": "/api/cron/connect-outreach",
      "schedule": "10 19 * * *"
    }
  ]
}
