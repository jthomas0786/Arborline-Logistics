DATABASE_URL=postgresql://arborline:arborline@localhost:5432/arborline
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTOMATION_INTERNAL_TOKEN=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret

# ArborLine Connect worker queue. Master workers are enabled after dry-run validation; provider spending is enabled only for the controlled real-prospect pilot.
CONNECT_WORKERS_ENABLED=true
CONNECT_WORKERS_PROVIDER_SPEND_ENABLED=true
CONNECT_WORKER_BATCH_LIMIT=5

# ArborLine Connect prospect sourcing. Apollo is preferred when APOLLO_API_KEY is set.
APOLLO_API_KEY=
APOLLO_MAX_ORGS_PER_RUN=20
# Optional generic provider fallback.
PROSPECT_SOURCE_API_URL=
PROSPECT_SOURCE_API_KEY=

# ArborLine Connect contact enrichment. Prospeo is enabled first; Hunter can be added later.
PROSPEO_API_KEY=
HUNTER_API_KEY=

# Production communications. Test-only/.invalid recipients are suppressed.
# Connect outreach sends from the verified mail subdomain; replies are routed through Resend receiving.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Josh Thomas <josh@mail.arborlineconnect.com>"
RESEND_WEBHOOK_SECRET=

# Keep live outreach false by default. Production may enable it temporarily for an explicitly reviewed controlled pilot only after postal-address and unsubscribe-signing requirements are satisfied.
CONNECT_LIVE_OUTREACH_ENABLED=false
CONNECT_BUSINESS_POSTAL_ADDRESS=
CONNECT_UNSUBSCRIBE_SECRET=
CONNECT_DAILY_SEND_LIMIT=10

# Requested walkthrough fulfillment only responds to a matched prospect reply that explicitly accepts the 2-minute walkthrough offer.
# Keep auto-send disabled until the approved MP4 is uploaded through /growth/walkthrough and the public /walkthrough page is verified.
# CONNECT_WALKTHROUGH_URL is optional; production falls back to APP_BASE_URL + /walkthrough.
CONNECT_WALKTHROUGH_AUTO_SEND_ENABLED=false
CONNECT_WALKTHROUGH_URL=

# Stripe billing. Production uses live Stripe credentials after sandbox checkout + webhook validation; keep test values only in local/test environments.
# Founding Client launch offer: $750/month, $0 setup, month-to-month.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_MONTHLY_PRICE_ID=

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=https://arborlineconnect.com
COMMUNICATIONS_MAX_ATTEMPTS=5

FMCSA_WEB_KEY=
CARRIER_INSURANCE_VERIFICATION_URL=
CARRIER_VERIFICATION_WEBHOOK_URL=
CARRIER_VERIFICATION_WEBHOOK_TOKEN=
CARRIER_VERIFICATION_TTL_HOURS=24
AUTOMATION_TARGET_MARGIN_PCT=15
AUTOMATION_MIN_MARGIN_PCT=10
AUTOMATION_MAX_DEADHEAD_MILES=75
AUTOMATION_SEARCH_RADII=25,50,75,100,150
AUTOMATION_OFFER_FANOUT=3
AUTOMATION_OFFER_TTL_MINUTES=15
AUTOMATION_MAX_RATE_INCREASE=175
PRICING_DRY_VAN_RPM=2.35
PRICING_REEFER_RPM=2.85
PRICING_FLATBED_RPM=2.75
