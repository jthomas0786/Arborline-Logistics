DATABASE_URL=postgresql://arborline:arborline@localhost:5432/arborline
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
AUTOMATION_INTERNAL_TOKEN=replace-with-a-long-random-secret

# ArborLine Connect prospect sourcing. Apollo is preferred when APOLLO_API_KEY is set.
APOLLO_API_KEY=
APOLLO_MAX_ORGS_PER_RUN=20
# Optional generic provider fallback.
PROSPECT_SOURCE_API_URL=
PROSPECT_SOURCE_API_KEY=

# ArborLine Connect contact enrichment. Prospeo is enabled first; Hunter can be added later.
PROSPEO_API_KEY=
HUNTER_API_KEY=

# Production communications. Test-only/.invalid recipients are suppressed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# ArborLine Connect production outreach remains locked unless all three are configured.
CONNECT_LIVE_OUTREACH_ENABLED=false
CONNECT_BUSINESS_POSTAL_ADDRESS=
CONNECT_UNSUBSCRIBE_SECRET=
CONNECT_DAILY_SEND_LIMIT=10

# Stripe billing. Use sandbox/test values until the full checkout + webhook flow is verified.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_MONTHLY_PRICE_ID=
STRIPE_FOUNDING_SETUP_PRICE_ID=

WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=https://arborlineconnect.com
COMMUNICATIONS_MAX_ATTEMPTS=5

FMCSA_WEB_KEY=
CARRIER_INSURANCE_VERIFICATION_URL=
CARRIER_VERIFICATION_WEBHOOK_URL=
CARRIER_VERIFICATION_WEBHOOK_TOKEN=
CARRIER_VERIFICATION_TTL_HOURS=24
AUTOMATION_TARGET_MARGIN_PCT=15
AUTOMATION_MIN_MARGIN_PCT=10
AUTOMATION_MAX_DEADHEAD_MILES=75
AUTOMATION_SEARCH_RADII=25,50,75,100,150
AUTOMATION_OFFER_FANOUT=3
AUTOMATION_OFFER_TTL_MINUTES=15
AUTOMATION_MAX_RATE_INCREASE=175
PRICING_DRY_VAN_RPM=2.35
PRICING_REEFER_RPM=2.85
PRICING_FLATBED_RPM=2.75
